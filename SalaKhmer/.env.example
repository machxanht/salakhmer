# SalaKhmer — Firebase Environment Variables
# Copy this file to .env and fill in your values from Firebase Console

# Go to: https://console.firebase.google.com
# → Your Project → Project Settings → General → Your apps → Web App

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Comma-separated owner emails allowed to see /admin in the app UI.
# This only controls visibility; the future Cloudflare Worker will enforce admin
# permissions again on every write or publish request.
VITE_ADMIN_EMAILS=owner@example.com

# URL of the protected Cloudflare CMS Worker.
VITE_CMS_API_URL=https://your-worker.workers.dev

# Server/local generation only. Never prefix private service credentials with VITE_.
GEMINI_API_KEY=your_server_gemini_key_here
GOOGLE_TTS_API_KEY=your_google_cloud_tts_key_here
AZURE_TTS_API_KEY=your_azure_speech_key_here
AZURE_TTS_REGION=your_azure_region_here

# Optional server-side Firebase REST verification key. The public web Firebase
# config above remains client-visible by design; restrict it in Google Cloud.
FIREBASE_API_KEY=your_api_key_here
