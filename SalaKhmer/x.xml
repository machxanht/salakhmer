<svg xmlns="http://w3.org" viewBox="0 0 400 300" width="100%" height="100%" style="background-color: #faf6ec;">
  <!-- ĐỊNH NGHĨA ĐẦU MŨI TÊN (MARKERS) -->
  <defs>
    <!-- Mũi tên đen cho nét vẽ chính -->
    <marker id="arrow-black" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#000000" />
    </marker>
    <!-- Mũi tên nâu cho đường đứt nét hướng dẫn -->
    <marker id="arrow-guide" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M 0 2 L 7 5 L 0 8 z" fill="#c68a4c" />
    </marker>
  </defs>

  <!-- 1. HỆ THỐNG ĐƯỜNG LƯỚI NỀN (GRID LINES) -->
  <line x1="50" y1="80" x2="350" y2="80" stroke="#e1d7c6" stroke-width="1.5" />
  <line x1="50" y1="160" x2="350" y2="160" stroke="#e1d7c6" stroke-width="1.5" />
  <line x1="50" y1="240" x2="350" y2="240" stroke="#e1d7c6" stroke-width="1.5" />
  <line x1="200" y1="40" x2="200" y2="260" stroke="#e1d7c6" stroke-width="1.5" stroke-dasharray="4 4" />

  <!-- 2. ĐƯỜNG HƯỚNG DẪN ĐỨT NÉT VÀ ĐIỂM SỐ (DẤU MÓC TRÊN ĐẦU CHỮ ក) -->
  <!-- Nét hướng dẫn số 1 (Từ điểm số 1 đi lên) -->
  <path d="M 165,225 L 165,140" fill="none" stroke="#c68a4c" stroke-width="2.5" stroke-dasharray="3 3" />
  
  <!-- Nét hướng dẫn số 2 (Vòng từ đỉnh qua phải xuống điểm số 2) -->
  <path d="M 175,120 C 175,70 255,50 255,160" fill="none" stroke="#c68a4c" stroke-width="2.5" stroke-dasharray="3 3" marker-end="url(#arrow-guide)" />

  <!-- Các vòng tròn số định vị số 1 và số 2 -->
  <circle cx="165" cy="225" r="9" fill="none" stroke="#c68a4c" stroke-width="1.5" />
  <text x="165" y="228" font-family="Arial" font-size="10" font-weight="bold" fill="#c68a4c" text-anchor="middle">1</text>

  <circle cx="255" cy="165" r="9" fill="none" stroke="#c68a4c" stroke-width="1.5" />
  <text x="255" y="168" font-family="Arial" font-size="10" font-weight="bold" fill="#c68a4c" text-anchor="middle">2</text>

  <!-- 3. HÌNH PHÁC HỌA CỦA BẠN (MŨI TÊN ĐEN TO CHỈ HƯỚNG VẼ) -->
  <!-- Mũi tên đen số 1 (Chỉ hướng đi lên bên trái) -->
  <path d="M 130,220 L 130,170" fill="none" stroke="#000000" stroke-width="4.5" stroke-linecap="round" marker-end="url(#arrow-black)" />
  <text x="105" y="205" font-family="Arial" font-size="32" font-weight="bold" fill="#000000">1</text>

  <!-- Mũi tên đen số 2 (Móc vòng lên đầu) -->
  <path d="M 155,125 L 155,100 Q 155,75 195,75" fill="none" stroke="#000000" stroke-width="4.5" stroke-linecap="round" marker-end="url(#arrow-black)" />
  <text x="165" y="55" font-family="Arial" font-size="32" font-weight="bold" fill="#000000">2</text>

  <!-- 4. THÂN CHỮ KHMER CHÍNH (Chữ ក nét liền màu nâu đặc) -->
  <path d="M 180,240 L 180,150 C 180,135 190,125 205,125 C 220,125 230,135 230,150 L 230,240 M 180,140 Q 185,115 195,125 Q 205,135 215,125 Q 225,115 230,140" 
        fill="none" stroke="#4a2e1b" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
</svg>
